# APIの共通パス。開発時はViteがバックエンドへプロキシします。
VITE_API_BASE_URL=/api/v0
API_PROXY_TARGET=http://localhost:3000

# galerieと同じOIDC設定。trueのビルドでのみ認証を有効にする。
VITE_AUTH_ENABLED=false
# VITE_AUTH_AUTHORITY=https://id.example.com
# VITE_AUTH_CLIENT_ID=tonhalle
# VITE_AUTH_RESOURCE=https://api.tonhalle.example.com
# VITE_AUTH_SCOPE=openid profile
# IdPにはSPAのデプロイルートURLをリダイレクト先として登録する。
